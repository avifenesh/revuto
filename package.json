{
  "name": "revuto",
  "version": "0.1.0",
  "type": "module",
  "description": "Local, supplier-agnostic, repo-agnostic autonomous PR reviewer. Stands up a learning reviewer for any repo: clone + onboard + PR-history backfill \u2192 curated skill, then poll-review + learn loop with skills graduated into an external (Obsidian) vault.",
  "license": "MIT",
  "author": "Avi Fenesh",
  "keywords": [
    "pr-review",
    "code-review",
    "ai",
    "agent",
    "llm",
    "openai-compatible",
    "obsidian",
    "surrealdb",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avifenesh/revuto.git"
  },
  "homepage": "https://github.com/avifenesh/revuto#readme",
  "bugs": {
    "url": "https://github.com/avifenesh/revuto/issues"
  },
  "bin": {
    "revuto": "dist/daemon/src/cli.js"
  },
  "files": [
    "dist",
    "agent-knowledge/skill-writing-best-practices.md",
    "agents/common/rg",
    "scripts/surreal-start.sh",
    "scripts/llama-server.sh",
    "scripts/revuto-guard.sh",
    "deploy",
    "revuto.config.example.json",
    "README.md",
    "LICENSE",
    "docs/providers.md",
    "docs/github-app.md",
    "docs/reviews.md",
    "docs/configuration.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "dev": "tsx daemon/src/cli.ts",
    "reembed-concerns": "tsx scripts/reembed-concerns.ts",
    "start": "node --enable-source-maps dist/daemon/src/cli.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@agent-sh/harness-core": "^0.9.1",
    "@agent-sh/harness-glob": "^0.9.1",
    "@agent-sh/harness-grep": "^0.9.1",
    "@agent-sh/harness-read": "^0.9.1",
    "@agent-sh/harness-write": "^0.9.1",
    "@ai-sdk/openai-compatible": "3.0.78",
    "@ai-sdk/provider": "4.0.17",
    "@aws-sdk/credential-provider-node": "^3.972.50",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/auth-app": "^8.3.0",
    "@octokit/rest": "^22.0.1",
    "@smithy/hash-node": "^4.3.6",
    "@smithy/protocol-http": "^5.4.6",
    "@smithy/signature-v4": "^5.4.6",
    "ai": "7.0.143",
    "better-sqlite3": "^13.0.3",
    "gray-matter": "^4.0.3",
    "node-cron": "^4.5.0",
    "surrealdb": "^2.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.6.5",
    "@types/node-cron": "^3.0.11",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "valibot": "^1.2.0"
  }
}
