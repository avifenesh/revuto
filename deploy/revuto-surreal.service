[Unit]
Description=revuto SurrealDB (memory backend for the PR reviewer)
After=network.target

[Service]
Type=simple
# REVUTO_SURREAL_PASSWORD comes from ~/.config/revuto/env (scripts/surreal-start.sh or
# `revuto init-config` generates it). Browsers are refused and scripting is off.
# The start script reads it and passes it to surreal through SURREAL_PASS, not argv.
ExecStart=%h/projects/revuto/scripts/surreal-start.sh
Environment=SURREAL_DATA=%h/revuto/memory/surreal
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
